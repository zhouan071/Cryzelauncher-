diff -ruN a/ZalithLauncher/src/main/res/layout/fragment_settings_host.xml b/ZalithLauncher/src/main/res/layout/fragment_settings_host.xml
--- a/ZalithLauncher/src/main/res/layout/fragment_settings_host.xml	1970-01-01 00:00:00.000000000 +0000
