+    private boolean bannerAnimating = false;
+
+    /** Scale that keeps a quarter-turned banner covering the whole (landscape) panel. */
+    private float bannerCoverScale(int quarterTurns) {
+        if (quarterTurns % 2 == 0) return 1f;
+        float w = binding.bannerContainer.getWidth();
+        float h = binding.bannerContainer.getHeight();
+        if (w <= 0 || h <= 0) return 1f;
+        return Math.max(w / h, h / w);
+    }
+
+    private void applyBannerRotation(int quarterTurns) {
+        float scale = bannerCoverScale(quarterTurns);
+        binding.bannerImage.setRotation(quarterTurns * 90f);
+        binding.bannerImage.setScaleX(scale);
+        binding.bannerImage.setScaleY(scale);
+    }
+
+    /** Smoothly turns the banner a quarter turn (rotation + zoom animate together) and remembers it. */
+    private void rotateBanner() {
+        if (bannerAnimating) return;
+        SharedPreferences prefs = requireContext().getSharedPreferences(UI_PREFS, Context.MODE_PRIVATE);
+        final int current = prefs.getInt(KEY_BANNER_ROTATION, 0);
+        final int next = (current + 1) % 4;
+        prefs.edit().putInt(KEY_BANNER_ROTATION, next).apply();
+        final float scale = bannerCoverScale(next);
+        bannerAnimating = true;
+        binding.bannerImage.animate()
+                .rotation(current * 90f + 90f)
+                .scaleX(scale)
+                .scaleY(scale)
+                .setDuration(520)
+                .setInterpolator(new DecelerateInterpolator(1.6f))
+                .withEndAction(() -> {
+                    applyBannerRotation(next);
+                    bannerAnimating = false;
+                })
+                .start();
+    }
+
+    private void onBannerPicked(@Nullable Uri uri) {
+        if (uri == null) return;
+        final Context context = requireContext().getApplicationContext();
+        new Thread(() -> {
+            try {
+                File target = new File(context.getFilesDir(), "cz_banner.img");
+                try (InputStream in = context.getContentResolver().openInputStream(uri);
+                     OutputStream out = new FileOutputStream(target)) {
+                    if (in == null) throw new IllegalStateException("Cannot open the selected image");
+                    byte[] buffer = new byte[16384];
+                    int read;
+                    while ((read = in.read(buffer)) != -1) out.write(buffer, 0, read);
+                }
+                context.getSharedPreferences(UI_PREFS, Context.MODE_PRIVATE).edit()
+                        .putString(KEY_BANNER_PATH, target.getAbsolutePath())
+                        .putInt(KEY_BANNER_ROTATION, 0)
+                        .apply();
+                loadBanner();
+            } catch (Exception e) {
+                TaskExecutors.runInUIThread(() ->
+                        Toast.makeText(context, R.string.cz_banner_load_failed, Toast.LENGTH_SHORT).show());
+            }
+        }).start();
+    }
+
+    /** Decodes the saved banner (downsampled, rotated by the saved quarter-turns) and shows it. */
+    private void loadBanner() {
+        final Context context = getContext();
+        if (context == null) return;
+        final FragmentLauncherBinding currentBinding = binding;
+        new Thread(() -> {
+            SharedPreferences prefs = context.getSharedPreferences(UI_PREFS, Context.MODE_PRIVATE);
+            String path = prefs.getString(KEY_BANNER_PATH, null);
+            int rotation = prefs.getInt(KEY_BANNER_ROTATION, 0);
+            Bitmap bitmap = null;
+            boolean failed = false;
+            if (path != null && new File(path).exists()) {
+                try {
+                    BitmapFactory.Options bounds = new BitmapFactory.Options();
+                    bounds.inJustDecodeBounds = true;
+                    BitmapFactory.decodeFile(path, bounds);
+                    int sample = 1;
+                    while (bounds.outWidth / sample > 2400 || bounds.outHeight / sample > 2400) sample *= 2;
+                    BitmapFactory.Options options = new BitmapFactory.Options();
+                    options.inSampleSize = sample;
+                    bitmap = BitmapFactory.decodeFile(path, options);
+                    if (bitmap == null) failed = true;
+
+                } catch (Throwable t) {
+                    bitmap = null;
+                    failed = true;
+                }
+            }
+            final Bitmap result = bitmap;
+            final boolean loadFailed = failed;
+            final int rotationState = rotation;
+            TaskExecutors.runInUIThread(() -> {
+                if (!isAdded() || currentBinding != binding) return;
+                currentBinding.bannerImage.setImageBitmap(result);
+                currentBinding.bannerContainer.post(() -> {
+                    if (isAdded() && currentBinding == binding) applyBannerRotation(rotationState);
+                });
+                boolean hasBanner = result != null;
+                currentBinding.btnBannerOrientation.setEnabled(hasBanner);
+                currentBinding.btnBannerOrientation.setAlpha(hasBanner ? 1f : 0.45f);
+                if (loadFailed) Toast.makeText(context, R.string.cz_banner_load_failed, Toast.LENGTH_SHORT).show();
+            });
+        }).start();
     }
 
