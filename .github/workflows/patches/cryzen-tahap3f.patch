+package com.movtery.zalithlauncher.ui.subassembly.account
+
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import com.movtery.zalithlauncher.ui.view.SkinView3D
+import com.movtery.zalithlauncher.utils.path.PathManager
+import java.io.File
+
+/** Loads the saved skin of an account (or the default Steve skin) into a [SkinView3D]. */
+object Skin3DLoader {
+    @JvmStatic
+    fun load(view: SkinView3D, uuid: String?) {
+        val context = view.context.applicationContext
+        Thread {
+            val bitmap: Bitmap? = runCatching {
+                val file = if (uuid != null) File(PathManager.DIR_USER_SKIN, "$uuid.png") else null
+                if (file != null && file.exists()) BitmapFactory.decodeFile(file.absolutePath) else null
+            }.getOrNull() ?: runCatching {
+                context.assets.open("steve.png").use { BitmapFactory.decodeStream(it) }
+            }.getOrNull()
+            view.post { if (bitmap != null) view.setSkin(bitmap) }
+        }.start()
+    }
+}
