+package com.movtery.zalithlauncher.utils;
+
+import android.content.Context;
+import android.content.res.Configuration;
+import android.content.res.Resources;
+
+/**
+ * Violet / Dark / White theme selection.
+ * The chosen theme is applied as a resource qualifier on the activity resources
+ * (values-mcc001 = Dark, values-mcc002 = White, default values = Violet), so every
+ * color reference in layouts and drawables follows it without further changes.
+ */
+public final class CryzenTheme {
+    public static final int VIOLET = 0;
+    public static final int DARK = 1;
+    public static final int WHITE = 2;
+
+    private static final String PREFS = "cryzen_ui";
+    private static final String KEY_THEME = "theme";
+
+    private CryzenTheme() {}
+
+    public static int get(Context context) {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getInt(KEY_THEME, VIOLET);
+    }
+
+    public static void set(Context context, int theme) {
+        context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).edit().putInt(KEY_THEME, theme).apply();
+    }
+
+    /** Wraps a base context so its resources use the selected theme. */
+    public static Context wrap(Context base) {
+        int theme = get(base);
+        if (theme == VIOLET) return base;
+        Configuration config = new Configuration(base.getResources().getConfiguration());
+        config.mcc = theme;
+        return base.createConfigurationContext(config);
+    }
+
+    /** Re-applies the selected theme to an existing activity's resources. */
+    @SuppressWarnings("deprecation")
+    public static void apply(Context activity) {
+        int theme = get(activity);
+        if (theme == VIOLET) return;
+        Resources resources = activity.getResources();
+        Configuration config = new Configuration(resources.getConfiguration());
+        config.mcc = theme;
+        resources.updateConfiguration(config, resources.getDisplayMetrics());
+    }
+}
