+
+    private void updateNavSelection(Fragment fragment) {
+        View selected = null;
+        if (fragment instanceof MainMenuFragment) selected = binding.navHome;
+        else if (fragment instanceof AccountFragment) selected = binding.navAccount;
+        else if (fragment instanceof DownloadFragment) selected = binding.navMod;
+        else if (fragment instanceof ControlPageFragment || fragment instanceof ControlButtonFragment) selected = binding.navControl;
+        else if (fragment instanceof SettingsFragment) selected = binding.navSettings;
+        // Sub-pages (version list, downloads, files...) keep the highlight of the page they came from.
+        if (selected == null) return;
+        View[] items = {binding.navHome, binding.navAccount, binding.navMod, binding.navControl, binding.navSettings};
+        for (View item : items) item.setSelected(item == selected);
+        if (selected != lastNavSelected) {
+            lastNavSelected = selected;
+            moveNavHighlight(selected);
+        }
+    }
