+import net.kdt.pojavlaunch.Tools
+import net.kdt.pojavlaunch.progresskeeper.ProgressKeeper
+
+/**
+ * Compact account pill used on the Home page (avatar + name + chevron).
+ * Same data source as [AccountViewWrapper]; also feeds the optional skin preview panel.
+ */
+class AccountPillWrapper(
+    private val parentFragment: FragmentWithAnim,
+    val binding: ViewAccountPillBinding,
+    private val skinView: SkinView3D? = null
+) {
+    private val mContext: Context = binding.root.context
+
+    init {
+        binding.root.setOnClickListener { showMiniMenu(it) }
+    }
+
+    /** Mini menu: only "add account" and "switch account". */
+    private fun showMiniMenu(anchor: View) {
+        val menu = PopupMenu(mContext, anchor)
+        menu.menu.add(0, 1, 0, R.string.cz_account_add)
+        menu.menu.add(0, 2, 1, R.string.cz_account_switch)
+        menu.setOnMenuItemClickListener { item ->
+            when (item.itemId) {
+                1 -> ZHTools.swapFragmentWithAnim(parentFragment, AccountFragment::class.java, AccountFragment.TAG, null)
+                2 -> showSwitchMenu(anchor)
+            }
+            true
+        }
+        menu.show()
+    }
+
+    private fun showSwitchMenu(anchor: View) {
+        val accounts = AccountsManager.allAccounts
+        if (accounts.isEmpty()) {
+            Toast.makeText(mContext, R.string.cz_account_none, Toast.LENGTH_SHORT).show()
+            return
+        }
+        val currentUuid = AccountsManager.currentAccount?.uniqueUUID
+        val menu = PopupMenu(mContext, anchor)
+        accounts.forEachIndexed { index, account ->
+            menu.menu.add(0, index, index, account.username).apply {
+                isCheckable = true
+                isChecked = account.uniqueUUID == currentUuid
+            }
+        }
+        menu.menu.setGroupCheckable(0, true, true)
+        menu.setOnMenuItemClickListener { item ->
+            if (ProgressKeeper.getTaskCount() > 0) {
+                Toast.makeText(mContext, R.string.tasks_ongoing, Toast.LENGTH_SHORT).show()
+            } else {
+                AccountsManager.currentAccount = accounts[item.itemId]
+            }
+            true
+        }
+        menu.show()
+    }
+
+    fun refreshAccountInfo() {
+        binding.apply {
+            val account = AccountsManager.currentAccount
+            account ?: run {
+                userIcon.setImageDrawable(ContextCompat.getDrawable(mContext, R.drawable.ic_add))
+                userName.setText(R.string.account_add)
+                accountType.visibility = View.GONE
+                skinView?.let { Skin3DLoader.load(it, null) }
+                return
+            }
+
+            runCatching {
+                val size = Tools.dpToPx(mContext.resources.getDimensionPixelSize(R.dimen._52sdp).toFloat()).toInt()
+                userIcon.setImageDrawable(SkinLoader.getAvatarDrawable(mContext, account, size))
+            }.onFailure { e ->
+                Logging.e("AccountPillWrapper", "Failed to load avatar.", e)
+            }
+
+            skinView?.let { Skin3DLoader.load(it, account.uniqueUUID) }
+            userName.text = account.username
+            accountType.text = AccountUtils.getAccountTypeName(mContext, account)
+            accountType.visibility = View.VISIBLE
+        }
+    }
+}
