+        menu.getMenu().add(1, 11, 6, R.string.cz_theme_dark).setCheckable(true).setChecked(currentTheme == com.movtery.zalithlauncher.utils.CryzenTheme.DARK);
+        menu.getMenu().add(1, 12, 7, R.string.cz_theme_white).setCheckable(true).setChecked(currentTheme == com.movtery.zalithlauncher.utils.CryzenTheme.WHITE);
+        menu.getMenu().setGroupCheckable(1, true, true);
