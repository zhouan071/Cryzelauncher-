+    private View lastNavSelected = null;
+    private boolean navHighlightPlaced = false;
+
+    /** One gradient pill behind the icons that glides to the selected item. */
+    private void moveNavHighlight(View item) {
+        final View highlight = binding.czNavHighlight;
+        final View icon = ((ViewGroup) item).getChildAt(0);
+        binding.czSidebar.post(() -> {
+            float targetY = item.getTop() + icon.getTop() + (icon.getHeight() - highlight.getHeight()) / 2f;
+            float targetX = (binding.czSidebar.getWidth() - highlight.getWidth()) / 2f;
+            highlight.setTranslationX(targetX);
+            if (!navHighlightPlaced) {
+                highlight.setTranslationY(targetY);
+                highlight.setVisibility(View.VISIBLE);
+                navHighlightPlaced = true;
+            } else {
+                highlight.animate().translationY(targetY)
+                        .setDuration(300)
+                        .setInterpolator(new DecelerateInterpolator(1.5f))
+                        .start();
+            }
+        });
+    }
