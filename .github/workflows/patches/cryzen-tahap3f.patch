+package com.movtery.zalithlauncher.ui.view;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.os.SystemClock;
+import android.util.AttributeSet;
+import android.view.MotionEvent;
+import android.view.View;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Full-body, rotating 3D preview of a Minecraft skin.
+ * Drawn on a plain Canvas (every box face is a perspective-projected bitmap mesh),
+ * so it clips, fades and animates like any other view. Drag horizontally to turn the player.
+ */
+public class SkinView3D extends View {
+    private static final int GRID = 3;
+    private static final float CAMERA_DISTANCE = 110f;
+    private static final float PITCH = 0.18f;
+    private static final float AUTO_SPEED = 0.0006f; // radians per millisecond
+
+    private static final class Face {
+        final float[] corners; // top-left, top-right, bottom-left (x, y, z each) in model space
+        final Bitmap bitmap;
+
+        Face(float[] corners, Bitmap bitmap) {
+            this.corners = corners;
+            this.bitmap = bitmap;
+        }
+    }
+
+    private final List<Face> faces = new ArrayList<>();
+    private final Paint paint = new Paint();
+    private float[] rotated = new float[0];
+    private float[] depth = new float[0];
+    private int[] order = new int[0];
+    private final float[] verts = new float[2 * (GRID + 1) * (GRID + 1)];
+
+    private float yaw = -0.5f;
+    private long lastFrame = 0;
+    private boolean dragging = false;
+    private float lastX;
+
+    public SkinView3D(Context context) {
+        this(context, null);
+    }
+
+    public SkinView3D(Context context, AttributeSet attrs) {
+        super(context, attrs);
+        paint.setFilterBitmap(false);
+        paint.setAntiAlias(false);
+        paint.setDither(false);
+    }
+
+    /** Sets the skin texture (64x64, 64x32 or HD multiples). Must be called on the UI thread. */
+    public void setSkin(Bitmap skin) {
+        if (skin == null || skin.getWidth() < 64) return;
+        List<Face> built = buildFaces(skin);
+        for (Face old : faces) old.bitmap.recycle();
+        faces.clear();
+        faces.addAll(built);
+        rotated = new float[faces.size() * 9];
+        depth = new float[faces.size()];
+        order = new int[faces.size()];
+        invalidate();
+    }
+
+    private List<Face> buildFaces(Bitmap skin) {
+        final float sc = skin.getWidth() / 64f;
+        final boolean legacy = skin.getHeight() * 2 == skin.getWidth();
+        final boolean slim = !legacy && isSlim(skin, sc);
+        final float armW = slim ? 3f : 4f;
+        final float armX = 4f + armW / 2f;
+        List<Face> out = new ArrayList<>();
+
+        // base layers (the player's right side is on the viewer's left)
+        addBox(out, skin, sc, 0, 28, 0, 8, 8, 8, 0, 0, 0f);
+        addBox(out, skin, sc, 0, 18, 0, 8, 12, 4, 16, 16, 0f);
+        addBox(out, skin, sc, -armX, 18, 0, armW, 12, 4, 40, 16, 0f);
+        addBox(out, skin, sc, armX, 18, 0, armW, 12, 4, legacy ? 40 : 32, legacy ? 16 : 48, 0f);
+        addBox(out, skin, sc, -2, 6, 0, 4, 12, 4, 0, 16, 0f);
+        addBox(out, skin, sc, 2, 6, 0, 4, 12, 4, legacy ? 0 : 16, legacy ? 16 : 48, 0f);
+
+        // overlay layers (hat, jacket, sleeves, pants)
+        final float inflate = 0.5f;
+        addBox(out, skin, sc, 0, 28, 0, 8, 8, 8, 32, 0, inflate);
+        if (!legacy) {
+            addBox(out, skin, sc, 0, 18, 0, 8, 12, 4, 16, 32, inflate);
+            addBox(out, skin, sc, -armX, 18, 0, armW, 12, 4, 40, 32, inflate);
+            addBox(out, skin, sc, armX, 18, 0, armW, 12, 4, 48, 48, inflate);
+            addBox(out, skin, sc, -2, 6, 0, 4, 12, 4, 0, 32, inflate);
+            addBox(out, skin, sc, 2, 6, 0, 4, 12, 4, 0, 48, inflate);
+        }
+        return out;
+    }
+
+    private boolean isSlim(Bitmap skin, float sc) {
+        int x = (int) (47 * sc);
+        int y = (int) (24 * sc);
+        if (x >= skin.getWidth() || y >= skin.getHeight()) return false;
+        return Color.alpha(skin.getPixel(x, y)) == 0;
+    }
+
+    private void addBox(List<Face> out, Bitmap skin, float sc,
+                        float cx, float cy, float cz, float w, float h, float d,
+                        float u, float v, float inflate) {
+        final float hw = w / 2f + inflate, hh = h / 2f + inflate, hd = d / 2f + inflate;
+        // front
+        addFace(out, skin, sc, u + d, v + d, w, h,
+                cx - hw, cy + hh, cz + hd, cx + hw, cy + hh, cz + hd, cx - hw, cy - hh, cz + hd);
+        // back
+        addFace(out, skin, sc, u + d + w + d, v + d, w, h,
+                cx + hw, cy + hh, cz - hd, cx - hw, cy + hh, cz - hd, cx + hw, cy - hh, cz - hd);
+        // right side (-x)
+        addFace(out, skin, sc, u, v + d, d, h,
+                cx - hw, cy + hh, cz - hd, cx - hw, cy + hh, cz + hd, cx - hw, cy - hh, cz - hd);
+        // left side (+x)
+        addFace(out, skin, sc, u + d + w, v + d, d, h,
+                cx + hw, cy + hh, cz + hd, cx + hw, cy + hh, cz - hd, cx + hw, cy - hh, cz + hd);
+        // top
+        addFace(out, skin, sc, u + d, v, w, d,
+                cx - hw, cy + hh, cz - hd, cx + hw, cy + hh, cz - hd, cx - hw, cy + hh, cz + hd);
+        // bottom
+        addFace(out, skin, sc, u + d + w, v, w, d,
+                cx - hw, cy - hh, cz + hd, cx + hw, cy - hh, cz + hd, cx - hw, cy - hh, cz - hd);
+    }
+
+    private void addFace(List<Face> out, Bitmap skin, float sc, float tx, float ty, float tw, float th,
+                         float... corners) {
+        int x = Math.round(tx * sc);
+        int y = Math.round(ty * sc);
+        int w = Math.max(1, Math.round(tw * sc));
+        int h = Math.max(1, Math.round(th * sc));
+        if (x < 0 || y < 0 || x + w > skin.getWidth() || y + h > skin.getHeight()) return;
+        out.add(new Face(corners, Bitmap.createBitmap(skin, x, y, w, h)));
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        super.onDraw(canvas);
+        final int count = faces.size();
+        if (count == 0) return;
+
+        long now = SystemClock.uptimeMillis();
+        if (lastFrame != 0 && !dragging) yaw += (now - lastFrame) * AUTO_SPEED;
+        lastFrame = now;
+
+        final float width = getWidth(), height = getHeight();
+        final float scale = Math.min(height / 36f, width / 22f);
+        final float cx = width / 2f, cy = height / 2f;
+        final float cosY = (float) Math.cos(yaw), sinY = (float) Math.sin(yaw);
+        final float cosP = (float) Math.cos(PITCH), sinP = (float) Math.sin(PITCH);
+
+        int visible = 0;
+        for (int i = 0; i < count; i++) {
+            float[] c = faces.get(i).corners;
+            for (int k = 0; k < 3; k++) {
+                float x = c[3 * k];
+                float y = c[3 * k + 1] - 16f;
+                float z = c[3 * k + 2];
+                float x1 = x * cosY + z * sinY;
+                float z1 = -x * sinY + z * cosY;
+                float y2 = y * cosP - z1 * sinP;
+                float z2 = y * sinP + z1 * cosP;
+                rotated[i * 9 + 3 * k] = x1;
+                rotated[i * 9 + 3 * k + 1] = y2;
+                rotated[i * 9 + 3 * k + 2] = z2;
+            }
+            int b = i * 9;
+            float ax = rotated[b + 3] - rotated[b], ay = rotated[b + 4] - rotated[b + 1];
+            float bx = rotated[b + 6] - rotated[b], by = rotated[b + 7] - rotated[b + 1];
+            float crossZ = ax * by - ay * bx;
+            if (crossZ < 0f) { // facing the camera
+                depth[i] = (rotated[b + 5] + rotated[b + 2] + rotated[b + 8]) / 3f;
+                // insertion sort by depth, farthest first
+                int pos = visible++;
+                while (pos > 0 && depth[order[pos - 1]] > depth[i]) {
+                    order[pos] = order[pos - 1];
+                    pos--;
+                }
+                order[pos] = i;
+            }
+        }
+
+        for (int n = 0; n < visible; n++) {
+            int i = order[n];
+            int b = i * 9;
+            float ax = rotated[b + 3] - rotated[b], ay = rotated[b + 4] - rotated[b + 1], az = rotated[b + 5] - rotated[b + 2];
+            float bx = rotated[b + 6] - rotated[b], by = rotated[b + 7] - rotated[b + 1], bz = rotated[b + 8] - rotated[b + 2];
+            int vi = 0;
+            for (int j = 0; j <= GRID; j++) {
+                float fv = j / (float) GRID;
+                for (int k = 0; k <= GRID; k++) {
+                    float fu = k / (float) GRID;
+                    float px = rotated[b] + fu * ax + fv * bx;
+                    float py = rotated[b + 1] + fu * ay + fv * by;
+                    float pz = rotated[b + 2] + fu * az + fv * bz;
+                    float s = CAMERA_DISTANCE / (CAMERA_DISTANCE - pz);
+                    verts[vi++] = cx + px * s * scale;
+                    verts[vi++] = cy - py * s * scale;
+                }
+            }
+            canvas.drawBitmapMesh(faces.get(i).bitmap, GRID, GRID, verts, 0, null, 0, paint);
+        }
+        postInvalidateOnAnimation();
+    }
+
+    @Override
+    public boolean onTouchEvent(MotionEvent event) {
+        switch (event.getActionMasked()) {
+            case MotionEvent.ACTION_DOWN:
+                dragging = true;
+                lastX = event.getX();
+                if (getParent() != null) getParent().requestDisallowInterceptTouchEvent(true);
+                return true;
+            case MotionEvent.ACTION_MOVE:
+                yaw += (event.getX() - lastX) * 0.012f;
+                lastX = event.getX();
+                invalidate();
+                return true;
+            case MotionEvent.ACTION_UP:
+            case MotionEvent.ACTION_CANCEL:
+                dragging = false;
+                lastFrame = SystemClock.uptimeMillis();
+                return true;
+            default:
+                return super.onTouchEvent(event);
+        }
+    }
+}
