+    // ---- CryzenLauncher sidebar navigation ----
+    private void initCryzenSidebar() {
+        binding.navHome.setOnClickListener(v -> navigateTo(MainMenuFragment.class, MainMenuFragment.TAG, null));
+        binding.navAccount.setOnClickListener(v -> navigateTo(AccountFragment.class, AccountFragment.TAG, null));
+        binding.navMod.setOnClickListener(v -> navigateTo(DownloadFragment.class, DownloadFragment.TAG, null));
+        binding.navControl.setOnClickListener(v -> navigateTo(ControlPageFragment.class, ControlPageFragment.TAG, null));
+        binding.navSettings.setOnClickListener(v -> navigateTo(SettingsFragment.class, SettingsFragment.TAG, null));
+        binding.czAppIcon.setOnClickListener(this::showToolsMenu);
+
+        getSupportFragmentManager().registerFragmentLifecycleCallbacks(new FragmentManager.FragmentLifecycleCallbacks() {
+            @Override
+            public void onFragmentResumed(@NonNull FragmentManager fm, @NonNull Fragment f) {
+                updateNavSelection(f);
+            }
+        }, false);
+    }
+
+    private void navigateTo(Class<? extends Fragment> fragmentClass, String tag, @Nullable Bundle bundle) {
+        Fragment current = getCurrentFragment();
+        if (current == null || fragmentClass.isInstance(current)) return;
+        ZHTools.swapFragmentWithAnim(current, fragmentClass, tag, bundle);
+    }
+
+    private void updateNavSelection(Fragment fragment) {
+        View selected = null;
+        if (fragment instanceof MainMenuFragment) selected = binding.navHome;
+        else if (fragment instanceof AccountFragment) selected = binding.navAccount;
+        else if (fragment instanceof DownloadFragment) selected = binding.navMod;
+        else if (fragment instanceof ControlPageFragment || fragment instanceof ControlButtonFragment) selected = binding.navControl;
+        else if (fragment instanceof SettingsFragment) selected = binding.navSettings;
+        // Sub-pages (version list, downloads, files...) keep the highlight of the page they came from.
+        if (selected == null) return;
+        View[] items = {binding.navHome, binding.navAccount, binding.navMod, binding.navControl, binding.navSettings};
+        for (View item : items) item.setSelected(item == selected);
+    }
+
+    /** Tools that used to live in the old top bar / Home menu; reachable from the app icon. */
+    private void showToolsMenu(View anchor) {
+        PopupMenu menu = new PopupMenu(this, anchor);
+        menu.getMenu().add(0, 2, 1, R.string.cz_menu_about);
+        menu.getMenu().add(0, 3, 2, R.string.main_open_main_dir);
+        menu.getMenu().add(0, 4, 3, R.string.main_install_jar_file);
+        menu.getMenu().add(0, 5, 4, R.string.main_share_logs);
+        menu.setOnMenuItemClickListener(item -> {
+            Fragment current = getCurrentFragment();
+            switch (item.getItemId()) {
+                case 2:
+                    if (current != null) ZHTools.swapFragmentWithAnim(current, AboutFragment.class, AboutFragment.TAG, null);
+                    return true;
+                case 3:
+                    if (current != null) {
+                        Bundle bundle = new Bundle();
+                        bundle.putString(FilesFragment.BUNDLE_LIST_PATH, PathManager.DIR_GAME_HOME);
+                        ZHTools.swapFragmentWithAnim(current, FilesFragment.class, FilesFragment.TAG, bundle);
+                    }
+                    return true;
+                case 4:
+                    if (ProgressKeeper.getTaskCount() == 0) Tools.installMod(this, false);
+                    else Toast.makeText(this, R.string.tasks_ongoing, Toast.LENGTH_LONG).show();
+                    return true;
+                case 5:
+                    ZHTools.shareLogs(this);
+                    return true;
+                default:
+                    return false;
+            }
+        });
+        menu.show();
+    }
+
